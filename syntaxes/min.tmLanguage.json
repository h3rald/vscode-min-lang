{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "min",
  "scopeName": "source.min",
  "patterns": [
    {
      "include": "#value"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#comments-inline"
        },
        {
          "include": "#comments-block"
        },
        {
          "include": "#comments-doc-inline"
        },
        {
          "include": "#comments-doc-block"
        },
        {
          "match": "^#!.*\\n",
          "name": "comment.line.shebang.min"
        }
      ]
    },
    "comments-inline": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.min"
            }
          },
          "match": "(;).*$\\n?",
          "name": "comment.line.semicolon.min"
        }
      ]
    },
    "comments-doc-inline": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.min"
            }
          },
          "match": "(;;).*$\\n?",
          "name": "comment.line.double.semicolon.min"
        }
      ]
    },
    "comments-block": {
      "patterns": [
        {
          "begin": "\\#\\|",
          "end": "\\|\\#",
          "name": "comment.block.hashpipe.min",
          "patterns": [
            {
              "include": "#comments-block"
            }
          ]
        }
      ]
    },
    "comments-doc-block": {
      "patterns": [
        {
          "begin": "\\#\\|\\|",
          "end": "\\|\\|\\#",
          "name": "comment.block.double.hashpipe.min",
          "patterns": [
            {
              "include": "#comments-block"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<=(\\s|^|\\(|\\{))-?0x[0-9a-fA-F]+(?=(\\s|\\)|\\}|$))",
          "name": "constant.numeric.hexadecimal.min"
        },
        {
          "match": "(?<=(\\s|^|\\(|\\{))-?0b[01]+(?=(\\s|\\)|\\}|$))",
          "name": "constant.numeric.binary.min"
        },
        {
          "match": "(?<=(\\s|^|\\(|\\{))-?0o[0-7]+(?=(\\s|\\)|\\}|$))",
          "name": "constant.numeric.octal.min"
        },
        {
          "match": "(?<=(\\s|^|\\(|\\{))-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?(?=(\\s|\\)|\\}|$))",
          "name": "constant.numeric.decimal.min"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "(?<=(\\s|^|\\(|\\{))(int|flt|bool|a|num|str|'sym|quot|dict|dict:[a-z0-9_-]+)(?=(\\s|\\)|\\}|$))",
          "name": "support.type.min"
        }
      ]
    },
    "control-symbol": {
      "patterns": [
        {
          "match": "(?<=(\\s|^|\\(|\\{))(symbol|sigil|constructor|operator|return|include|require|lambda|lambda-bind|bind|define|typeclass|typealias|if|unless|when|foreach|times|while|raise|try|case|with|apply|dequote|quote|quotesym|quotecmd|>>|><|=>|==>|::|=-=|--|->|&&|\\|\\||=%|%|infix-dequote|prefix-dequote|tap|tap!|with|expect|expect-all|expect-any|expect-empty-stack)(?=(\\s|\\)|\\}|$))",
          "name": "keyword.control.min"
        }
      ]
    },
    "quotation": {
      "begin": "(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.array.begin.min"
        }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.array.end.min"
        }
      },
      "name": "meta.structure.array.min",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "command": {
      "begin": "(\\[)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.command.begin.min"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.command.end.min"
        }
      },
      "name": "meta.structure.command.min",
      "patterns": [
        {
          "match": "([^\\]]+)",
          "name": "string.quoted.other.command.min"
        }
      ]
    },
    "placeholder": {
      "patterns": [
        {
          "match": "(\\$)([0-9]+|#)",
          "name": "variable.other.min"
        }
      ]
    },
    "dictionary": {
      "begin": "(\\{)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.dictionary.begin.min"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.dictionary.end.min"
        }
      },
      "name": "meta.structure.dictionary.min",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "system-module": {
      "patterns": [
        {
          "match": "(?<=(\\s|^|\\(|\\{))(global|crypto|dict|fs|http|io|math|net|stack|store|sys|time|xml)",
          "name": "storage.type.module.min"
        }
      ]
    },
    "dot": {
      "patterns": [
        {
          "match": "[.]",
          "name": "keyword.control.dot.min"
        }
      ]
    },
    "bang": {
      "patterns": [
        {
          "match": "[!](?=(\\s|\\)|\\}|$))",
          "name": "keyword.control.bang.min"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "include": "#system-module"
        },
        {
          "include": "#dot"
        },
        {
          "include": "#bang"
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9/?+*_-]*)",
          "name": "variable.name.min"
        }
      ]
    },
    "sigil-symbol": {
      "begin": "([:@'~$?^])",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.sigil.min"
        }
      },
      "end": "(?=(\\s|\\)|\\}|$))",
      "patterns": [
        {
          "include": "#symbol"
        }
      ]
    },
    "autopop-symbol": {
      "begin": "(?<=(\\s|^|\\(|\\{))",
      "end": "([!])(?=(\\s|\\)|\\}|$))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.bang.min"
        }
      },
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9/!?+.*_-]*)",
          "name": "entity.name.function.min"
        }
      ]
    },
    "constant": {
      "match": "(?<=(\\s|^|\\(|\\{))(true|false|global|pi|e|tau|null)(?=(\\s|\\)|\\}|$))",
      "name": "constant.language.min"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.min"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.min"
        }
      },
      "name": "string.quoted.double.min",
      "patterns": [
        {
          "include": "#escaped-char"
        },
        {
          "include": "#placeholder"
        }
      ]
    },
    "escaped-char": {
      "patterns": [
        {
          "match": "\\\\[cC]|\\\\[rR]",
          "name": "constant.character.escape.carriagereturn.min"
        },
        {
          "match": "\\\\[lL]|\\\\[nN]",
          "name": "constant.character.escape.linefeed.min"
        },
        {
          "match": "\\\\[fF]",
          "name": "constant.character.escape.formfeed.min"
        },
        {
          "match": "\\\\[tT]",
          "name": "constant.character.escape.tabulator.min"
        },
        {
          "match": "\\\\[vV]",
          "name": "constant.character.escape.verticaltabulator.min"
        },
        {
          "match": "\\\\\\\"",
          "name": "constant.character.escape.double-quote.min"
        },
        {
          "match": "\\\\'",
          "name": "constant.character.escape.single-quote.min"
        },
        {
          "match": "\\\\[aA]",
          "name": "constant.character.escape.alert.min"
        },
        {
          "match": "\\\\[bB]",
          "name": "constant.character.escape.backspace.min"
        },
        {
          "match": "\\\\[eE]",
          "name": "constant.character.escape.escape.min"
        },
        {
          "match": "\\\\\\\\",
          "name": "constant.character.escape.backslash.min"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#quotation"
        },
        {
          "include": "#command"
        },
        {
          "include": "#type"
        },
        {
          "include": "#control-symbol"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#sigil-symbol"
        },
        {
          "include": "#symbol"
        }
      ]
    }
  }
}
